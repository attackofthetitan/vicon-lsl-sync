<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>
	<!-- LSL finds and reads streams on the local network, and without this reason
	     macOS shows an unhelpful prompt or simply denies the access. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Vicon LSL Bridge finds and records Lab Streaming Layer streams published by Vicon and the HoloLens on your local network.</string>
	<!-- macOS asks before the app uses these folders or drives, and because the
	     bundled recorders run as its helpers, the answer also covers their XDF files. -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Vicon LSL Bridge saves recordings in the study folder you choose, and opens recordings for preview.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>Vicon LSL Bridge saves recordings in the study folder you choose, and opens recordings for preview.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Vicon LSL Bridge saves recordings in the study folder you choose, and opens recordings for preview.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Vicon LSL Bridge saves recordings in the study folder you choose, including one on an external drive.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Vicon LSL Bridge saves recordings in the study folder you choose, including one on a network drive.</string>
</dict>
</plist>
